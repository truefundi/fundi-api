generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  id                 String                      @id @default(uuid())
  email              String?                     @unique
  phoneNumber        String                      @unique
  fullName           String
  role               UserRole                    @default(CUSTOMER)
  status             UserStatus                  @default(ACTIVE)
  phoneVerifiedAt    DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  passwordHash       String?
  totpSecret         String?
  totpEnabledAt      DateTime?
  customerJobs       Job[]                       @relation("JobCustomer")
  refreshTokens      RefreshToken[]
  technicianProfile  TechnicianProfile?
  bookingPayments    BookingPayment[]
  phoneVerifications CustomerPhoneVerification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  sessionId String   @unique @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ServiceCategory {
  id              String               @id @default(uuid())
  name            String               @unique
  slug            String               @unique
  isActive        Boolean              @default(true)
  bookingFee      Int?
  createdAt       DateTime             @default(now())
  jobs            Job[]                @relation("JobServiceCategory")
  technicians     TechnicianCategory[]
  documents       TechnicianDocument[]
  bookingPayments BookingPayment[]

  @@map("service_categories")
}

model TechnicianProfile {
  id                      String                    @id @default(uuid())
  userId                  String                    @unique
  nationalIdEncrypted     String?
  nationalIdHash          String?                   @unique
  nationalIdLast4         String?
  baseAddress             String
  baseLatitude            Float?
  baseLongitude           Float?
  verificationStatus      VerificationStatus        @default(PENDING)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  gender                  TechnicianGender
  profilePictureMimeType  String?
  availabilityStatus      TechnicianAvailability    @default(OFFLINE)
  rejectionCount          Int                       @default(0)
  cancellationCount       Int                       @default(0)
  baseLocation            Unsupported("geography")?
  publicLocationLabel     String?
  profilePictureObjectKey String?
  paymentMethod           PaymentMethod
  paymentNumber           String
  jobAssignments          JobAssignmentHistory[]
  jobOffers               JobOffer[]
  assignedJobs            Job[]                     @relation("CurrentJobTechnician")
  categories              TechnicianCategory[]
  documents               TechnicianDocument[]
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@index([availabilityStatus, verificationStatus])
  @@map("technician_profiles")
}

model TechnicianCategory {
  technicianId         String
  categoryId           String?
  customName           String?
  customNameNormalized String            @default("")
  id                   String            @id @default(uuid())
  yearsOfExperience    Int
  category             ServiceCategory?  @relation(fields: [categoryId], references: [id])
  technician           TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([technicianId])
  @@map("technician_categories")
}

model TechnicianDocument {
  id                       String            @id @default(uuid())
  technicianId             String
  title                    String
  titleNormalized          String
  objectKey                String
  mimeType                 String
  originalFileName         String
  sizeBytes                Int
  status                   DocumentStatus    @default(SUBMITTED)
  reviewNote               String?
  reviewedById             String?
  reviewedAt               DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  certificateType          CertificateType?
  categoryId               String?
  customCategoryName       String?
  customCategoryNormalized String?
  type                     DocumentType
  category                 ServiceCategory?  @relation(fields: [categoryId], references: [id])
  technician               TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId, status])
  @@index([status])
  @@index([type])
  @@index([categoryId])
  @@map("technician_documents")
}

model Job {
  id                          String                     @id @default(uuid())
  customerId                  String
  technicianId                String?
  serviceCategoryId           String?
  otherServiceName            String?
  description                 String
  locationAddress             String
  latitude                    Float
  longitude                   Float
  location                    Unsupported("geography")?
  offeredAmount               Int
  currency                    String                     @default("RWF")
  priority                    JobPriority                @default(NORMAL)
  status                      JobStatus                  @default(OPEN)
  cooperationStatus           JobCooperationStatus       @default(PENDING)
  dispatchStatus              JobDispatchStatus          @default(PENDING)
  dispatchRound               Int                        @default(1)
  customerProgress            JobProgressStatus          @default(PENDING)
  technicianProgress          JobProgressStatus          @default(PENDING)
  customerConfirmedAt         DateTime?
  technicianConfirmedAt       DateTime?
  customerHiddenAt            DateTime?
  technicianHiddenAt          DateTime?
  customerPauseRequestedAt    DateTime?
  technicianPauseRequestedAt  DateTime?
  customerResumeRequestedAt   DateTime?
  technicianResumeRequestedAt DateTime?
  assignedAt                  DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  assignmentHistory           JobAssignmentHistory[]
  media                       JobMedia[]
  offers                      JobOffer[]
  conversation                Conversation?
  bookingPayment              BookingPayment?
  phoneVerificationId         String?                    @unique
  phoneVerification           CustomerPhoneVerification? @relation(fields: [phoneVerificationId], references: [id], onDelete: SetNull)
  cancellationRequests        JobCancellationRequest[]
  customer                    User                       @relation("JobCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  serviceCategory             ServiceCategory?           @relation("JobServiceCategory", fields: [serviceCategoryId], references: [id])
  technician                  TechnicianProfile?         @relation("CurrentJobTechnician", fields: [technicianId], references: [id])

  @@index([customerId, createdAt])
  @@index([technicianId, status, updatedAt])
  @@index([status, dispatchStatus, priority, createdAt])
  @@index([serviceCategoryId])
  @@index([customerId, customerHiddenAt, createdAt])
  @@index([technicianId, technicianHiddenAt, updatedAt])
  @@map("jobs")
}

model JobOffer {
  id              String            @id @default(uuid())
  jobId           String
  technicianId    String
  round           Int
  matchScore      Int
  distanceMeters  Float
  status          JobOfferStatus    @default(WAITING)
  offeredAt       DateTime?
  expiresAt       DateTime?
  respondedAt     DateTime?
  rejectionReason String?
  dropReason      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician      TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([jobId, technicianId, round])
  @@index([jobId, round, status, matchScore])
  @@index([technicianId, status, updatedAt])
  @@map("job_offers")
}

model BookingPayment {
  id                       String               @id @default(uuid())
  customerId               String
  serviceCategoryId        String
  jobId                    String?              @unique
  externalPaymentId        String               @unique
  paymentKeyId             String
  signature                String
  phoneNumber              String
  amount                   Int
  status                   BookingPaymentStatus @default(VALID)
  paidAt                   DateTime             @default(now())
  validUntil               DateTime
  remainingValiditySeconds Int?
  extensionCount           Int                  @default(0)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  customer                 User                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceCategory          ServiceCategory      @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  job                      Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([customerId, paidAt])
  @@index([status, validUntil])
  @@map("booking_payments")
}

model CustomerPhoneVerification {
  id         String    @id @default(uuid())
  customerId String
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  customer   User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job        Job?

  @@index([customerId, createdAt])
  @@map("customer_phone_verifications")
}

model JobCancellationRequest {
  id           String                    @id @default(uuid())
  jobId        String
  actorId      String
  requester    CancellationRequester
  reason       String
  status       CancellationRequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime                  @default(now())
  job          Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([status, createdAt])
  @@map("job_cancellation_requests")
}

model JobMedia {
  id               String       @id @default(uuid())
  jobId            String
  type             JobMediaType
  objectKey        String       @unique
  mimeType         String
  originalFileName String
  sizeBytes        Int
  durationSeconds  Float?
  createdAt        DateTime     @default(now())
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_media")
}

model JobAssignmentHistory {
  id             String             @id @default(uuid())
  jobId          String
  technicianId   String?
  technicianName String
  acceptedAt     DateTime           @default(now())
  endedAt        DateTime?
  endReason      String?
  reason         String?
  createdAt      DateTime           @default(now())
  job            Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician     TechnicianProfile? @relation(fields: [technicianId], references: [id])

  @@index([jobId, acceptedAt])
  @@index([technicianId, acceptedAt])
  @@map("job_assignment_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  fromStatus String?
  toStatus   String?
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// The single price-negotiation phase of a job. Opened when the request is sent
/// to the chosen technician; it stays PENDING until that technician accepts
/// (negotiation opens) or declines (the job returns to dispatch). Closed when
/// the two sides agree, decline, or the negotiation lapses. Chat is limited to
/// agreeing a price.
model Conversation {
  id            String                @id @default(uuid())
  jobId         String                @unique
  status        ConversationStatus    @default(PENDING)
  currency      String                @default("RWF")
  agreedAmount  Int?
  offerCount    Int                   @default(0)
  declinedById  String?
  declineReason String?
  startedAt     DateTime              @default(now())
  lastMessageAt DateTime              @default(now())
  closedAt      DateTime?
  job           Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages      ConversationMessage[]
  offers        PriceOffer[]

  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
  @@map("conversations")
}

/// One entry in a conversation. SERVICE_REQUEST is posted automatically when the
/// conversation opens; PRICE_OFFER entries carry a PriceOffer.
model ConversationMessage {
  id             String                  @id @default(uuid())
  conversationId String
  senderId       String?
  senderRole     ConversationSender
  type           ConversationMessageType
  text           String?
  metadata       Json?
  createdAt      DateTime                @default(now())
  conversation   Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  offer          PriceOffer?

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

/// A price offer or counter-offer. Exactly one offer is PENDING at a time;
/// posting a new offer supersedes the previous one.
model PriceOffer {
  id             String              @id @default(uuid())
  conversationId String
  messageId      String              @unique
  amount         Int
  currency       String              @default("RWF")
  senderRole     ConversationSender
  status         PriceOfferStatus    @default(PENDING)
  notes          String?
  expiresAt      DateTime?
  respondedAt    DateTime?
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@map("price_offers")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TechnicianAvailability {
  ONLINE
  OFFLINE
}

enum TechnicianGender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum DocumentType {
  NATIONAL_ID
  CERTIFICATE
}

enum CertificateType {
  TVET_CERTIFICATE
  DIPLOMA
  ADVANCED_DIPLOMA
  DEGREE
  SHORT_COURSE
  OTHER
}

enum DocumentStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  DENIED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobStatus {
  OPEN
  ASSIGNED
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum JobCooperationStatus {
  PENDING
  CONFIRMED
}

enum BookingPaymentStatus {
  VALID
  EXPIRED
  PAUSED
  RESUMED
  COMPLETED
}

enum CancellationRequester {
  CUSTOMER
  TECHNICIAN
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobDispatchStatus {
  PENDING
  OFFERED
  EXHAUSTED
  STOPPED
}

enum JobProgressStatus {
  PENDING
  STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum JobOfferStatus {
  WAITING
  OFFERED
  REJECTED
  EXPIRED
  ACCEPTED
  DROPPED
  CANCELLED
}

enum JobMediaType {
  PHOTO
  VIDEO
}

enum PaymentMethod {
  MOMO
  BANK_TRANSFER
  CASH
  OTHER
}

enum ConversationStatus {
  NEGOTIATING
  AGREED
  DECLINED
  EXPIRED
  // The conversation carries the job request until the assigned technician
  // accepts (-> NEGOTIATING) or declines (-> DECLINED) it.
  PENDING
}

enum ConversationSender {
  CUSTOMER
  TECHNICIAN
  SYSTEM
}

enum ConversationMessageType {
  SERVICE_REQUEST
  TEXT
  PRICE_OFFER
  SYSTEM
  // The assigned technician's acceptance or decline of the job request.
  TECHNICIAN_RESPONSE
}

enum PriceOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  SUPERSEDED
  EXPIRED
}
