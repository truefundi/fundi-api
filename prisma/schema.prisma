// Fundi Platform Prisma Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                String             @id @default(uuid())
  email             String?            @unique
  phoneNumber       String             @unique
  fullName          String
  role              UserRole           @default(CUSTOMER)
  status            UserStatus         @default(ACTIVE)
  // Nullable because customers and technicians sign in with phone + OTP only.
  // Deliberately not unique: bcrypt salts every hash, so two admins holding the same
  // password produce different hashes and no constraint could detect the overlap.
  passwordHash      String?
  // Second factor is an authenticator app, not an SMS code. The secret is encrypted
  // rather than hashed because the server must read it back to compute the expected
  // code. Set only once a first code has been accepted, so an abandoned enrolment
  // leaves nothing behind.
  totpSecret        String?
  totpEnabledAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  technicianProfile TechnicianProfile?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  sessionId String   @unique @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model ServiceCategory {
  id          String               @id @default(uuid())
  name        String               @unique
  slug        String               @unique
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  technicians TechnicianCategory[]

  @@map("service_categories")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TechnicianAvailability {
  ONLINE
  OFFLINE
}

enum TechnicianGender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

model TechnicianProfile {
  id                    String                   @id @default(uuid())
  userId                String                   @unique
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender                TechnicianGender?
  yearsOfExperience     Int?
  nationalIdEncrypted   String?
  nationalIdHash        String?                @unique
  baseAddress           String?
  publicLocationLabel   String?
  baseLatitude          Float?
  baseLongitude         Float?
  baseLocation          Unsupported("geography(Point,4326)")?
  profilePicture        Bytes?
  profilePictureMimeType String?
  verificationStatus    VerificationStatus       @default(PENDING)
  availabilityStatus    TechnicianAvailability   @default(OFFLINE)
  categories            TechnicianCategory[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([verificationStatus])
  @@index([availabilityStatus, verificationStatus])
  @@map("technician_profiles")
}

model TechnicianCategory {
  technicianId String
  categoryId   String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category     ServiceCategory   @relation(fields: [categoryId], references: [id])

  @@id([technicianId, categoryId])
  @@index([categoryId])
  @@map("technician_categories")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  fromStatus String?
  toStatus   String?
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
