// Fundi Platform Prisma Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TechnicianAvailability {
  ONLINE
  OFFLINE
}

enum TechnicianGender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}



enum DocumentType {
  NATIONAL_ID
  CERTIFICATE
}

enum CertificateType {
  TVET_CERTIFICATE
  DIPLOMA
  ADVANCED_DIPLOMA
  DEGREE
  SHORT_COURSE
  OTHER
}

enum DocumentStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  DENIED
}



enum PaymentMethod {
  MOMO
  BANK_TRANSFER
  CASH
  OTHER
}

model User {
  id                String             @id @default(uuid())
  email             String?            @unique
  phoneNumber       String             @unique
  fullName          String
  role              UserRole           @default(CUSTOMER)
  status            UserStatus         @default(ACTIVE)
  passwordHash      String?
  totpSecret        String?
  totpEnabledAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  technicianProfile TechnicianProfile?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  sessionId String   @unique @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model ServiceCategory {
  id          String               @id @default(uuid())
  name        String               @unique
  slug        String               @unique
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  technicians TechnicianCategory[]
  documents   TechnicianDocument[]   // ← new

  @@map("service_categories")
}

model TechnicianProfile {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  gender                  TechnicianGender
  nationalIdEncrypted     String
  nationalIdHash          String                   @unique

  baseAddress             String
  publicLocationLabel     String?
  baseLatitude            Float
  baseLongitude           Float
  baseLocation            Unsupported("geography(Point,4326)")?

  paymentMethod           PaymentMethod
  paymentNumber           String

  profilePictureObjectKey String?
  profilePictureMimeType  String?

  verificationStatus      VerificationStatus       @default(PENDING)
  availabilityStatus      TechnicianAvailability   @default(OFFLINE)

  categories              TechnicianCategory[]
  documents               TechnicianDocument[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([verificationStatus])
  @@index([availabilityStatus, verificationStatus])
  @@map("technician_profiles")
}

model TechnicianCategory {
  id                   String             @id @default(uuid())
  technicianId         String
  categoryId           String?
  customName           String?
  customNameNormalized String             @default("")
  yearsOfExperience    Int

  technician           TechnicianProfile  @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category             ServiceCategory?   @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([technicianId])
  @@map("technician_categories")
}


model TechnicianDocument {
  id                        String            @id @default(uuid())
  technicianId              String
  technician                TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  type                      DocumentType
  title                     String
  titleNormalized           String

  // Only meaningful when type = CERTIFICATE.
  certificateType           CertificateType?
  categoryId                String?
  category                  ServiceCategory?  @relation(fields: [categoryId], references: [id])
  customCategoryName        String?
  customCategoryNormalized  String?

  objectKey                 String
  mimeType                  String
  originalFileName          String
  sizeBytes                 Int
  status                    DocumentStatus    @default(SUBMITTED)
  reviewNote                String?
  reviewedById              String?
  reviewedAt                DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([technicianId, status])
  @@index([status])
  @@index([type])
  @@index([categoryId])
  @@map("technician_documents")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  fromStatus String?
  toStatus   String?
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
