# ─── Domain & Let's Encrypt TLS (Traefik) ────────────────────────────────────
API_DOMAIN=api.yourdomain.com
ACME_EMAIL=ops@yourdomain.com

# ─── PostgreSQL + PostGIS ────────────────────────────────────────────────────
POSTGRES_USER=fundi_prod
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=fundi_prod
DB_POOL_LIMIT=15

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ─── JWT & Token Hashing (generate each with: openssl rand -base64 48) ───────
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_base64_48
TOKEN_HASH_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── 32-Byte Encryption Keys (MUST be exact 64 hex chars: openssl rand -hex 32)
ADMIN_TOTP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FROM_openssl_rand_hex_32
NATIONAL_ID_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FROM_openssl_rand_hex_32

# ─── WebOrigin, CORS & Admin Cookies ─────────────────────────────────────────
# Comma-separated exact HTTPS origins of your Vercel web dashboard (no trailing slash).
CORS_ORIGINS=https://admin.yourdomain.com
# Same-site ('lax') works when API (api.yourdomain.com) and Web (admin.yourdomain.com)
# share a root domain. Use 'none' ONLY if Web is still on a *.vercel.app URL.
ADMIN_COOKIE_SAME_SITE=lax
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_RP_NAME=Fundi
WEBAUTHN_ORIGIN=https://admin.yourdomain.com

# ─── S3-Compatible Object Storage (Cloudflare R2 / AWS S3 / Backblaze B2) ────
S3_BUCKET=fundi-private-prod
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# ─── Booking Claim Signing & SMS ─────────────────────────────────────────────
MOCK_PAYMENT_KEY=CHANGE_ME_openssl_rand_hex_16
MOCK_PAYMENT_SECRET=CHANGE_ME_openssl_rand_hex_32
SMS_MODE=provider
