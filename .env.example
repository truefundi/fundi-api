# Backend API Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://fundi_user:fundi_secure_password_dev@localhost:5432/fundi_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Development prints OTP codes to the backend terminal; production needs an SMS provider.
SMS_MODE=console

# JWT Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_in_production_32chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_32chars
TOKEN_HASH_SECRET=dev_token_hash_secret_change_in_production_32chars
NATIONAL_ID_ENCRYPTION_KEY=replace_with_64_hex_char_secret
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OTP Configuration (codes are stored in Redis)
# Code lifetime in seconds. 300 is five minutes; the Redis key outlives it by a
# short grace period so an expired code is reported as expired, not as never sent.
OTP_TTL_SECONDS=300

# Admin dashboard sign-in (email + password, then an SMS second factor).
# Sessions live in httpOnly cookies rather than a token the browser holds. Lifetimes are
# deliberately shorter than the phone defaults above. See docs/admin-authentication.md.
ADMIN_BCRYPT_ROUNDS=12
ADMIN_ACCESS_EXPIRES_IN=15m
ADMIN_REFRESH_EXPIRES_IN=12h
# Wrong-password lockout. Counted per email address, so unknown addresses count too, and
# a correct password is still refused for the rest of the window.
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900
# Two-factor challenge lifetime, resend budget per challenge, and wrong-code budget per
# account. Resending a code does not reset the wrong-code count.
ADMIN_2FA_TTL_SECONDS=300
ADMIN_2FA_MAX_RESENDS=3
ADMIN_2FA_MAX_TRIES=5

# Admin cookies. SameSite and Secure decide whether a browser attaches the cookie at all.
# Postman and Swagger both ignore these rules, so they cannot tell you the cookie works;
# test the dashboard on its real origin instead. A cookie that is silently dropped looks
# exactly like a rejected password.
# 'lax' is correct while the dashboard is on the same site as the API, such as
# app.fundi.rw against api.fundi.rw. Use 'none' only for a genuinely different site, and
# browsers reject 'none' unless Secure is true as well.
ADMIN_COOKIE_SAME_SITE=lax
# Left unset so it follows NODE_ENV: true in production, false in development. Setting it
# to true locally over plain http makes clients drop the cookie and every admin call 401.
# ADMIN_COOKIE_SECURE=true
# Leave unset. The cookie is then host-only to the API host, which already covers a
# dashboard on a subdomain, since the request goes to the API rather than the dashboard.
# ADMIN_COOKIE_DOMAIN=

# Provisioning an administrator. These are read by `npm run prisma:seed-admin` only: the
# server never reads them and no API route can set an admin password. Keep them out of the
# production .env and set them in the shell for the one command that needs them, so the
# password stays out of a file that gets copied around.
# ADMIN_EMAIL=admin@fundi.rw
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=
# ADMIN_PHONE_NUMBER=

# CORS Configuration (Comma separated origins)
# The admin session is cookie-based, so the dashboard's origin has to be listed here
# explicitly and its fetch calls need credentials: 'include'. Browsers reject a wildcard
# on a credentialed request, so '*' will not work for the dashboard.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080
