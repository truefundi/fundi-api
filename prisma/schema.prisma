// Fundi Platform Prisma Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                String             @id @default(uuid())
  email             String?            @unique
  phoneNumber       String             @unique
  fullName          String
  role              UserRole           @default(CUSTOMER)
  status            UserStatus         @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  technicianProfile TechnicianProfile?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  sessionId String   @unique @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model ServiceCategory {
  id          String               @id @default(uuid())
  name        String               @unique
  slug        String               @unique
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  technicians TechnicianCategory[]

  @@map("service_categories")
}

enum VerificationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model TechnicianProfile {
  id                 String               @id @default(uuid())
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingStep     Int                  @default(1)
  yearsOfExperience  Int?
  tin                String?
  baseAddress        String?
  baseLatitude       Float?
  baseLongitude      Float?
  serviceRadiusKm    Int?
  verificationStatus VerificationStatus   @default(DRAFT)
  categories         TechnicianCategory[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([verificationStatus])
  @@map("technician_profiles")
}

model TechnicianCategory {
  technicianId String
  categoryId   String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category     ServiceCategory   @relation(fields: [categoryId], references: [id])

  @@id([technicianId, categoryId])
  @@index([categoryId])
  @@map("technician_categories")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  fromStatus String?
  toStatus   String?
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
